# Anizra Studio: server rules (Hostinger)
# Keep internal files out of the public website.

# Hide the Git folder and all Markdown notes (CLAUDE.md, README.md, ...)
RedirectMatch 404 /\.git
RedirectMatch 404 (?i)\.md$

# Do not list folder contents when a folder has no index.html
Options -Indexes

# Basic security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Always check for a newer page (HTML), so visitors get updates right away.
  # CSS, JS and images stay cached; their ?v= number handles updates.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
